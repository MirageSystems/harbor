# Copy to contracts/.env. Never commit the real file.

# Deployer key. Use a throwaway testnet wallet.
PRIVATE_KEY=

# Any Polygon Amoy RPC, e.g. https://rpc-amoy.polygon.technology
AMOY_RPC_URL=

# Optional. Needed only for --verify. Get one at https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=
