# Copy to .env.local. Everything here is public build-time config.

# Privy app ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# "local" (anvil on localhost:8545) or "amoy" (Polygon Amoy testnet)
NEXT_PUBLIC_CHAIN=local

# LetterOfCredit address on the chosen chain.
# Local: first anvil deploy lands at 0x5FbDB2315678afecb367f032d93F642f64180aa3
# Amoy:  0x5b1959F4a1542C72aD6a6f78e4F93a89BE947b35
NEXT_PUBLIC_LOC_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
